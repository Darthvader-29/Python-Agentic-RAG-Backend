# Required (app fails fast at startup if any missing)
GOOGLE_API_KEY=
PINECONE_API_KEY=
HUGGINGFACE_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional
UPLOADTHING_API_KEY=
PINECONE_INDEX_NAME=rag-knowledge-base
LOG_JSON=false

# Phase 1
ENVIRONMENT=development
# Leave blank in production (real AWS S3); dev auto-uses MinIO at http://localhost:9000
S3_ENDPOINT_URL=

# Dev MinIO defaults (must match docker-compose). In prod use real AWS values.
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=rag-documents

# Phase 2 — PostgreSQL (NeonDB)
# Use postgresql:// or postgresql+asyncpg://; the app auto-adds asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://user:pass@host/proddb?sslmode=require
# Used by repository tests only (set in CI / local dev; leave blank to skip DB tests)
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@host/testdb?sslmode=require
